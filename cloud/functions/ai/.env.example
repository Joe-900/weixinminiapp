# OpenAI 兼容的文本 Provider 配置示例（不要在此文件填写真实密钥）
# 管理员可通过 AI 云函数配置接口覆盖 baseURL/API Key；未覆盖字段继续读取这里对应的运行环境变量。
AI_BASE_URL=https://api.shuaiapi.com/v1
AI_MODEL=qwen3.7-flash
AI_API_KEY=
AI_TIMEOUT=30000
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_HISTORY_LIMIT=10
AI_QUESTION_LENGTH_LIMIT=1000
AI_DAILY_LIMIT=50
