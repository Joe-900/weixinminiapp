{
  "name": "reading-companion",
  "version": "1.0.0",
  "private": true,
  "description": "校园阅读伴读小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "build:swan": "taro build --type swan",
    "dev:swan": "taro build --type swan --watch",
    "build:alipay": "taro build --type alipay",
    "dev:alipay": "taro build --type alipay --watch",
    "build:tt": "taro build --type tt",
    "dev:tt": "taro build --type tt --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "taro build --type h5 --watch",
    "build:rn": "taro build --type rn",
    "dev:rn": "taro build --type rn --watch",
    "lint": "eslint src cloud --ext .ts,.tsx",
    "lint:fix": "eslint src cloud --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "build:cloud": "node scripts/build-cloud-functions.js",
    "build:cloud:check": "node scripts/build-cloud-functions.js --check"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tarojs/cli": "^4.2.0",
    "@tarojs/components": "^4.2.0",
    "@tarojs/helper": "^4.2.0",
    "@tarojs/plugin-framework-react": "^4.2.0",
    "@tarojs/plugin-platform-weapp": "^4.2.0",
    "@tarojs/react": "^4.2.0",
    "@tarojs/router": "^4.2.0",
    "@tarojs/runtime": "^4.2.0",
    "@tarojs/shared": "^4.2.0",
    "@tarojs/taro": "^4.2.0",
    "@tarojs/webpack5-runner": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@jest/types": "^29.6.0",
    "@tarojs/webpack5-prebundle": "^4.2.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-preset-taro": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "^4.2.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "sass": "^1.77.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
